---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { featuredProjects } from '../utils/projects';
import { withBase } from '../utils/url';

const projects = await getCollection('projects');
const featured = featuredProjects(projects, 3);

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const github = SOCIAL_LINKS.find((l) => l.icon === 'github' && l.href);

// Person JSON-LD — 구글이 사이트 주인을 하나의 '엔티티'로 인식하게 합니다.
const sameAs = SOCIAL_LINKS.filter((l) => l.href).map((l) => l.href);
const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_AUTHOR,
	url: new URL(withBase('/'), Astro.site).toString(),
	...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
		<style>
			.intro {
				padding-top: 72px;
				padding-bottom: 72px;
			}
			.intro h1 {
				margin: 0;
				max-width: 24em;
				font-size: 30px;
				line-height: 1.5;
				font-weight: 400;
				letter-spacing: -0.02em;
				text-wrap: pretty;
			}
			.intro-links {
				display: flex;
				flex-wrap: wrap;
				gap: 20px;
				margin: 20px 0 0;
				font-size: 15px;
			}
			.intro-links a {
				color: var(--accent);
			}
			.intro-links a:hover {
				color: rgb(var(--black));
			}
			.last {
				padding-bottom: 96px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<section class="intro">
				<h1>Spring·JPA로 백엔드를 만듭니다. 운영하다 막힌 지점과 고친 방법을 적어 둡니다.</h1>
				<p class="intro-links">
					{
						github && (
							<a href={github.href} target="_blank" rel="noopener noreferrer">
								GitHub
							</a>
						)
					}
					<a href={withBase('/blog')}>글 전체</a>
					<a href={withBase('/about')}>소개</a>
				</p>
			</section>

			{
				recentPosts.length > 0 && (
					<PostList posts={recentPosts} describeFirst heading="최근 글">
						<a slot="aside" class="more" href={withBase('/blog')}>
							전체 글 보기
						</a>
					</PostList>
				)
			}

			{
				featured.length > 0 && (
					<section class="section last">
						<div class="section-aside">
							<h2 class="section-label">만든 것</h2>
							<a class="more" href={withBase('/projects')}>
								프로젝트 {projects.length}개
							</a>
						</div>
						<ProjectList projects={featured} />
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
