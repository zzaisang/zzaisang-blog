---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectList from '../../components/ProjectList.astro';
import { SITE_TITLE } from '../../consts';
import { PROJECT_STATUS_LABELS, sortProjects } from '../../utils/projects';

const projects = sortProjects(await getCollection('projects'));
// 글 목록의 연도 그룹처럼 상태(운영·진행 중·보관)로 묶어 왼쪽 라벨 열에 둡니다.
const groups = Object.keys(PROJECT_STATUS_LABELS)
	.map((status) => ({ status, items: projects.filter((p) => p.data.status === status) }))
	.filter((g) => g.items.length > 0);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`프로젝트 · ${SITE_TITLE}`} description="만든 것들 — 실무·사이드 프로젝트 모음" />
		<style>
			.section:last-child {
				padding-bottom: 96px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<h1>만든 것</h1>
				<p>실무·사이드 프로젝트 {projects.length}개</p>
			</div>
			{
				groups.map((g) => (
					<section class="section">
						<h2 class="section-label">{PROJECT_STATUS_LABELS[g.status]}</h2>
						<ProjectList projects={g.items} showStatus={false} />
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
