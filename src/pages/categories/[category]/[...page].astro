---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Pagination from '../../../components/Pagination.astro';
import PostList from '../../../components/PostList.astro';
import { POSTS_PER_PAGE, SITE_TITLE } from '../../../consts';
import { CATEGORY_DESCRIPTIONS, categoryToSlug } from '../../../utils/categories';
import { withBase } from '../../../utils/url';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getCollection('blog');
	const cats = [...new Set(posts.map((p) => p.data.category).filter((c): c is string => Boolean(c)))];
	return cats.flatMap((cat) => {
		const catPosts = posts
			.filter((p) => p.data.category === cat)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return paginate(catPosts, {
			params: { category: categoryToSlug(cat) },
			props: { category: cat },
			pageSize: POSTS_PER_PAGE,
		});
	});
}) satisfies GetStaticPaths;

const { page, category } = Astro.props;
const pageSuffix = page.currentPage > 1 ? ` - ${page.currentPage}페이지` : '';
const description = CATEGORY_DESCRIPTIONS[category];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${category}${pageSuffix} · ${SITE_TITLE}`}
			description={`${category} 카테고리의 글 ${page.total}개`}
		/>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<a class="back" href={withBase('/categories')}>← 카테고리</a>
				<h1>{category}</h1>
				<p>{description ? `${description} · ` : ''}글 {page.total}개</p>
			</div>
			<PostList posts={page.data} showCategory={false} />
			<Pagination
				currentPage={page.currentPage}
				lastPage={page.lastPage}
				baseUrl={`/categories/${categoryToSlug(category)}`}
			/>
		</main>
		<Footer />
	</body>
</html>
