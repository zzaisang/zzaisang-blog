---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { CATEGORY_DESCRIPTIONS, categoryToSlug, sortCategories } from '../../utils/categories';
import { withBase } from '../../utils/url';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const post of posts) {
	const cat = post.data.category;
	if (cat) counts.set(cat, (counts.get(cat) ?? 0) + 1);
}
const categories = sortCategories([...counts.keys()]);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`카테고리 · ${SITE_TITLE}`} description="주제별로 모아 보는 글 목록" />
		<style>
			.rows {
				list-style: none;
				margin: 0 0 96px;
				padding: 0;
				font-size: 17px;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.rows li {
				display: grid;
				grid-template-columns: 200px minmax(0, 1fr) 80px;
				gap: 24px;
				padding: 14px 0;
				border-top: 1px solid rgb(var(--gray-light));
				align-items: baseline;
			}
			.name {
				font-weight: 500;
			}
			.desc,
			.count {
				font-size: 14px;
				color: rgb(var(--gray));
			}
			.count {
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
			@media (max-width: 720px) {
				.rows li {
					grid-template-columns: minmax(0, 1fr) auto;
					gap: 4px 12px;
				}
				.desc {
					grid-column: 1 / -1;
					grid-row: 2;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<h1>카테고리</h1>
				<p>주제별로 모아 보는 전체 {posts.length}개의 글</p>
			</div>
			<ul class="rows">
				{
					categories.map((cat) => (
						<li>
							<a class="name" href={withBase(`/categories/${categoryToSlug(cat)}/`)}>
								{cat}
							</a>
							<span class="desc">{CATEGORY_DESCRIPTIONS[cat]}</span>
							<span class="count">{counts.get(cat)}개</span>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
