---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';

// 카테고리·프로젝트 목록은 각 페이지에 있으므로 여기선 하는 일·기술·연락만 둡니다.
const stack = [
	'Java', 'Kotlin', 'Spring Boot', 'Spring Security', 'Spring Batch', 'Spring Cloud', 'JPA', 'jOOQ',
	'PostgreSQL', 'MongoDB', 'Redis', 'DynamoDB', 'Kafka', 'Flyway', 'AWS', 'CloudWatch', 'Sentry',
];
const contacts = SOCIAL_LINKS.filter((l) => l.href).map((l) => {
	const isMail = l.href.startsWith('mailto:');
	return { ...l, isMail, label: l.href.replace(/^(https?:\/\/|mailto:)/, '') };
});
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`소개 · ${SITE_TITLE}`} description="zzaisang과 이 블로그에 대한 소개입니다." />
		<style>
			.lead {
				margin: 0;
				padding-top: 14px;
				max-width: 36em;
				font-size: 17px;
				line-height: 1.85;
			}
			.lead + .lead {
				padding-top: 0;
				margin-top: 1em;
			}
			.rows {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 17px;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.rows li {
				display: grid;
				grid-template-columns: 160px minmax(0, 1fr);
				gap: 24px;
				padding: 14px 0;
				border-top: 1px solid rgb(var(--gray-light));
				align-items: baseline;
			}
			.name {
				font-weight: 500;
			}
			.rows a {
				color: var(--accent);
				font-size: 15px;
			}
			.rows a:hover {
				color: rgb(var(--black));
			}
			.stack span {
				white-space: nowrap;
			}
			.stack {
				font-size: 15px;
				color: rgb(var(--gray-dark));
			}
			.section:last-child {
				padding-bottom: 96px;
			}
			@media (max-width: 720px) {
				.rows li {
					grid-template-columns: minmax(0, 1fr) auto;
					gap: 4px 12px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<h1>소개</h1>
				<p>zzaisang의 개발 기록과 만든 것들</p>
			</div>

			<section class="section">
				<h2 class="section-label">하는 일</h2>
				<div>
					<p class="lead">
						10년차 백엔드 개발자다. 지금은 메디컬테크 회사에서 치과와 기공소를 잇는 B2B 플랫폼의 개발 리드를 맡고
						있다. 인가 체계, 스키마 관리, 동시성 제어처럼 한 번 잘못되면 되돌리기 어려운 영역을 주로 다룬다.
					</p>
					<p class="lead">운영하다 막힌 지점과 고친 방법을 이 블로그에 적는다.</p>
				</div>
			</section>

			<section class="section">
				<h2 class="section-label">기술</h2>
				<p class="lead stack">
					{stack.map((t, i) => (i < stack.length - 1 ? <><span>{t} ·</span> </> : <span>{t}</span>))}
				</p>
			</section>

			{
				contacts.length > 0 && (
					<section class="section">
						<h2 class="section-label">연락</h2>
						<ul class="rows">
							{contacts.map((c) => (
								<li>
									<span class="name">{c.name}</span>
									<a
										href={c.href}
										{...(c.isMail ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
