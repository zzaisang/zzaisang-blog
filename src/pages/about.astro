---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';

// 카테고리·프로젝트 목록은 각 페이지에 있으므로 여기선 하는 일·연락만 둡니다.
const contacts = SOCIAL_LINKS.filter((l) => l.href).map((l) => {
	const isMail = l.href.startsWith('mailto:');
	return { ...l, isMail, label: l.href.replace(/^(https?:\/\/|mailto:)/, '') };
});
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`소개 · ${SITE_TITLE}`} description="zzaisang과 이 블로그에 대한 소개입니다." />
		<style>
			/* 내용이 짧아 푸터가 화면 중간에 뜨지 않도록, 헤더·푸터 높이(약 200px)를 뺀 화면 높이만큼 본문을 늘립니다. */
			main {
				min-height: calc(100svh - 200px);
			}
			.nowrap {
				white-space: nowrap;
			}
			.lead {
				margin: 0;
				padding-top: 14px;
				max-width: 36em;
				font-size: 17px;
				line-height: 1.85;
			}
			.rows {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 17px;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.rows li {
				display: grid;
				grid-template-columns: 160px minmax(0, 1fr);
				gap: 24px;
				padding: 14px 0;
				border-top: 1px solid rgb(var(--gray-light));
				align-items: baseline;
			}
			.name {
				font-weight: 500;
			}
			.rows a {
				color: var(--accent);
				font-size: 15px;
			}
			.rows a:hover {
				color: rgb(var(--black));
			}
			.section:last-child {
				padding-bottom: 96px;
			}
			@media (max-width: 720px) {
				.rows li {
					grid-template-columns: minmax(0, 1fr) auto;
					gap: 4px 12px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<h1>소개</h1>
				<p>zzaisang의 개발 기록과 만든 것들</p>
			</div>

			<section class="section">
				<h2 class="section-label">하는 일</h2>
				<div>
					<p class="lead">
						백엔드를 기반으로 풀스택 개발을 합니다. Spring으로 서버와 데이터를 다루고, 필요한 <span class="nowrap">웹·앱</span> 화면까지 직접
						만듭니다.
					</p>
				</div>
			</section>

			{
				contacts.length > 0 && (
					<section class="section">
						<h2 class="section-label">연락</h2>
						<ul class="rows">
							{contacts.map((c) => (
								<li>
									<span class="name">{c.name}</span>
									<a
										href={c.href}
										{...(c.isMail ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
