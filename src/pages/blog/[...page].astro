---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? SITE_TITLE : `${SITE_TITLE} - ${page.currentPage}페이지`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<h1>글</h1>
				<p>전체 {page.total}개{page.lastPage > 1 && ` · ${page.currentPage}/${page.lastPage}페이지`}</p>
			</div>
			<PostList posts={page.data} />
			<Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl="/blog" />
		</main>
		<Footer />
	</body>
</html>
