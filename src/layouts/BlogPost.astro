---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import AdSense from '../components/AdSense.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { ADSENSE_SLOT_ARTICLE, SITE_AUTHOR, SITE_TITLE } from '../consts';
import { categoryToSlug } from '../utils/categories';
import { withBase } from '../utils/url';

type Props = CollectionEntry<'blog'>['data'] & {
	/** render() 가 돌려준 헤딩. h2 만 왼쪽 목차로 씁니다. */
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, category, tags, headings = [] } =
	Astro.props;
const toc = headings.filter((h) => h.depth === 2);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: canonicalURL.toString(),
	...(category ? { articleSection: category } : {}),
	...(tags && tags.length ? { keywords: tags.join(', ') } : {}),
	...(heroImage ? { image: new URL(heroImage.src, canonicalURL).toString() } : {}),
};
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		<style>
			.post {
				display: grid;
				grid-template-columns: 200px minmax(0, var(--content-width));
				gap: 56px;
				padding-top: 56px;
				padding-bottom: 96px;
			}
			.side {
				font-size: 14px;
				line-height: 1.6;
			}
			.sticky {
				position: sticky;
				top: 24px;
				display: flex;
				flex-direction: column;
				gap: 20px;
			}
			.meta {
				display: flex;
				flex-direction: column;
				gap: 2px;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
			}
			.meta a {
				color: rgb(var(--gray));
			}
			.meta a:hover,
			.toc a:hover {
				color: var(--accent);
			}
			.toc {
				display: flex;
				flex-direction: column;
				gap: 8px;
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 16px;
			}
			.toc a {
				color: rgb(var(--gray));
			}
			.toc a.current {
				color: rgb(var(--black));
				font-weight: 500;
			}
			.meta-inline {
				display: none;
			}
			.post-title {
				margin: 0;
			}
			.lede {
				margin: 16px 0 40px;
				font-size: 18px;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.hero {
				display: block;
				margin-bottom: 40px;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 4px 12px;
				margin-top: 48px;
				padding-top: 16px;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 14px;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.post {
					grid-template-columns: minmax(0, 1fr);
					gap: 24px;
					padding-top: 24px;
				}
				.side {
					display: none;
				}
				.meta-inline {
					display: block;
					margin: 0 0 12px;
					font-size: 14px;
					color: rgb(var(--gray));
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="wrap post">
			<aside class="side">
				<div class="sticky">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									<FormattedDate date={updatedDate} /> 수정
								</span>
							)
						}
						{
							category && (
								<a href={withBase(`/categories/${categoryToSlug(category)}/`)}>{category}</a>
							)
						}
					</div>
					{
						toc.length > 0 && (
							<nav class="toc" aria-label="목차">
								{toc.map((h) => (
									<a href={`#${h.slug}`}>{h.text}</a>
								))}
							</nav>
						)
					}
				</div>
			</aside>
			<article>
				<p class="meta-inline">
					<FormattedDate date={pubDate} />
					{category && <span> · {category}</span>}
				</p>
				<h1 class="post-title">{title}</h1>
				<p class="lede">{description}</p>
				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				{
					tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => (
								<span>#{tag}</span>
							))}
						</div>
					)
				}
				<AdSense slot={ADSENSE_SLOT_ARTICLE} />
			</article>
		</main>
		<Footer />
		<script>
			// 스크롤 위치에 맞춰 목차의 현재 항목을 표시합니다(화면 위쪽을 지난 마지막 h2).
			const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
			const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
			const update = () => {
				let current = 0;
				targets.forEach((el, i) => {
					if (el && el.getBoundingClientRect().top < 120) current = i;
				});
				links.forEach((a, i) => a.classList.toggle('current', i === current));
			};
			if (links.length) {
				update();
				addEventListener('scroll', update, { passive: true });
			}
		</script>
	</body>
</html>
