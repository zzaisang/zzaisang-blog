---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';
import { PROJECT_STATUS_LABELS, PROJECT_TYPE_LABELS } from '../utils/projects';
import { withBase } from '../utils/url';

// 포트폴리오 상세 전용 레이아웃. BlogPost 와 달리 광고(AdSense)·BlogPosting JSON-LD 를 넣지 않습니다.
type Props = CollectionEntry<'projects'>['data'];

const {
	title,
	summary,
	role,
	pubDate,
	updatedDate,
	techStack,
	projectType,
	status,
	teamSize,
	repoUrl,
	demoUrl,
	writeupSlug,
	confidential,
	heroImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: title,
	description: summary,
	dateCreated: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	...(techStack.length ? { keywords: techStack.join(', ') } : {}),
	...(!confidential && repoUrl ? { codeRepository: repoUrl } : {}),
	...(demoUrl ? { url: demoUrl } : {}),
	mainEntityOfPage: canonicalURL.toString(),
	...(heroImage ? { image: new URL(heroImage.src, canonicalURL).toString() } : {}),
};
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={summary} image={heroImage} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		<style>
			.post {
				display: grid;
				grid-template-columns: 200px minmax(0, var(--content-width));
				gap: 56px;
				padding-top: 56px;
				padding-bottom: 96px;
			}
			.side {
				display: flex;
				flex-direction: column;
				gap: 20px;
				font-size: 14px;
				line-height: 1.6;
				color: rgb(var(--gray));
			}
			.side dl {
				display: flex;
				flex-direction: column;
				gap: 2px;
				margin: 0;
			}
			.side dd {
				margin: 0;
			}
			.side a {
				color: rgb(var(--gray));
			}
			.side a:hover {
				color: var(--accent);
			}
			.stack,
			.links {
				display: flex;
				flex-direction: column;
				gap: 4px;
				margin: 0;
				padding: 16px 0 0;
				list-style: none;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.links a {
				color: var(--accent);
			}
			.post-title {
				margin: 0;
			}
			.lede {
				margin: 16px 0 40px;
				font-size: 18px;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.hero {
				display: block;
				margin-bottom: 40px;
			}
			.writeup {
				margin-top: 48px;
				padding-top: 16px;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 15px;
			}
			.writeup a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.post {
					grid-template-columns: minmax(0, 1fr);
					gap: 24px;
					padding-top: 24px;
				}
				.side {
					order: 2;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="wrap post">
			<aside class="side">
				<dl>
					<dt class="sr-only">구분</dt>
					<dd>
						{PROJECT_TYPE_LABELS[projectType] ?? projectType} · {PROJECT_STATUS_LABELS[status] ?? status}
					</dd>
					<dt class="sr-only">시작</dt>
					<dd><FormattedDate date={pubDate} /></dd>
					{
						updatedDate && (
							<>
								<dt class="sr-only">수정</dt>
								<dd>
									<FormattedDate date={updatedDate} /> 수정
								</dd>
							</>
						)
					}
					{
						(role || teamSize) && (
							<>
								<dt class="sr-only">역할</dt>
								<dd>{[role, teamSize].filter(Boolean).join(' · ')}</dd>
							</>
						)
					}
				</dl>
				{
					techStack.length > 0 && (
						<ul class="stack" aria-label="기술 스택">
							{techStack.map((t) => (
								<li>{t}</li>
							))}
						</ul>
					)
				}
				<ul class="links" aria-label="링크">
					{
						!confidential && repoUrl && (
							<li>
								<a href={repoUrl} target="_blank" rel="noopener noreferrer">
									코드 ↗
								</a>
							</li>
						)
					}
					{
						demoUrl && (
							<li>
								<a href={demoUrl} target="_blank" rel="noopener noreferrer">
									데모 ↗
								</a>
							</li>
						)
					}
					{confidential && <li>소스 비공개 · 요청 시 공유</li>}
					<li>
						<a href={withBase('/projects')}>← 프로젝트 목록</a>
					</li>
				</ul>
			</aside>
			<article>
				<h1 class="post-title">{title}</h1>
				<p class="lede">{summary}</p>
				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				{
					writeupSlug && (
						<p class="writeup">
							<a href={withBase(`/blog/${writeupSlug}/`)}>관련 글 읽기 →</a>
						</p>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
