---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';
import { withBase } from '../utils/url';

// 포트폴리오 상세 전용 레이아웃. BlogPost 와 달리 광고(AdSense)·BlogPosting JSON-LD 를 넣지 않습니다.
type Props = CollectionEntry<'projects'>['data'] & {
	/** render() 가 돌려준 헤딩. h2 만 왼쪽 목차로 씁니다. */
	headings?: MarkdownHeading[];
};

const {
	title,
	summary,
	pubDate,
	updatedDate,
	techStack,
	repoUrl,
	demoUrl,
	writeupSlug,
	confidential,
	heroImage,
	headings = [],
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: title,
	description: summary,
	dateCreated: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	...(techStack.length ? { keywords: techStack.join(', ') } : {}),
	...(!confidential && repoUrl ? { codeRepository: repoUrl } : {}),
	...(demoUrl ? { url: demoUrl } : {}),
	mainEntityOfPage: canonicalURL.toString(),
	...(heroImage ? { image: new URL(heroImage.src, canonicalURL).toString() } : {}),
};
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={summary} image={heroImage} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		<style>
			/* 글 상세와 같은 2열 틀: 왼쪽 200px sticky 메타·목차, 오른쪽 본문. */
			.post {
				display: grid;
				grid-template-columns: 200px minmax(0, var(--content-width));
				gap: 56px;
				padding-top: 56px;
				padding-bottom: 96px;
			}
			.side {
				font-size: 14px;
				line-height: 1.6;
			}
			.sticky {
				position: sticky;
				top: 24px;
				display: flex;
				flex-direction: column;
				gap: 20px;
			}
			.meta {
				display: flex;
				flex-direction: column;
				gap: 2px;
				color: rgb(var(--gray));
			}
			.meta a,
			.toc a {
				color: rgb(var(--gray));
			}
			.meta a:hover,
			.toc a:hover {
				color: var(--accent);
			}
			.toc {
				display: flex;
				flex-direction: column;
				gap: 8px;
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 16px;
			}
			.post-title {
				margin: 0;
			}
			.lede {
				margin: 16px 0 32px;
				font-size: 18px;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.hero {
				display: block;
				margin-bottom: 40px;
			}
			.writeup {
				margin-top: 48px;
				padding-top: 16px;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 15px;
			}
			.writeup a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.post {
					grid-template-columns: minmax(0, 1fr);
					gap: 24px;
					padding-top: 24px;
				}
				.side {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="wrap post">
			<aside class="side">
				<div class="sticky">
					<div class="meta">
						<a href={withBase('/projects')}>← 프로젝트</a>
					</div>
					{
						toc.length > 0 && (
							<nav class="toc" aria-label="목차">
								{toc.map((h) => (
									<a href={`#${h.slug}`}>{h.text}</a>
								))}
							</nav>
						)
					}
				</div>
			</aside>
			<article>
				<h1 class="post-title">{title}</h1>
				<p class="lede">{summary}</p>
				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				{
					writeupSlug && (
						<p class="writeup">
							<a href={withBase(`/blog/${writeupSlug}/`)}>관련 글 읽기 →</a>
						</p>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
