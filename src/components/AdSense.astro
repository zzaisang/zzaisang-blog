---
import { ADSENSE_CLIENT } from '../consts';

interface Props {
	/** AdSense 광고 단위 슬롯 ID (AdSense 대시보드에서 광고 단위 생성 후 발급) */
	slot?: string;
	/** 광고 형식. 기본값 'auto'(반응형) */
	format?: string;
	/** 반응형 전체 폭 사용 여부 */
	responsive?: boolean;
	/** 광고 컨테이너 인라인 스타일 */
	style?: string;
	/** 추가 클래스 */
	class?: string;
}

const {
	slot,
	format = 'auto',
	responsive = true,
	style = 'display:block',
	class: className,
} = Astro.props;

// 게시자 ID 와 슬롯이 모두 있을 때만 렌더링 (미설정 시 깨진 광고 요청 방지).
// 광고 로더(adsbygoogle.js)도 여기서만 넣습니다. 전역 <head> 에 두면 광고 단위가 없는 홈·목록·소개에서도
// 로더가 실려 자동 광고(Auto ads)가 붙을 수 있으므로, 이 컴포넌트를 쓰는 글 상세(BlogPost)에만 싣습니다.
// 한 페이지에 이 컴포넌트는 한 번만 둡니다.
const enabled = Boolean(ADSENSE_CLIENT && slot);
---

{
	enabled && (
		<div class:list={['adsense', className]} aria-hidden="true">
			<script
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
				crossorigin="anonymous"
				is:inline
			/>
			<ins
				class="adsbygoogle"
				style={style}
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={slot}
				data-ad-format={format}
				data-full-width-responsive={responsive ? 'true' : 'false'}
			/>
			<script is:inline>
				(window.adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		</div>
	)
}

<style>
	.adsense {
		display: block;
		margin: 2rem auto;
		text-align: center;
		min-height: 1px;
		overflow: hidden;
	}
</style>
