---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';

const today = new Date();
---

<footer class="wrap">
	<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
	<a href={withBase('/rss.xml')}>RSS</a>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
		padding-top: 32px;
		padding-bottom: 40px;
		font-size: 13px;
		color: rgb(var(--gray));
	}
	a {
		color: rgb(var(--gray));
	}
</style>
