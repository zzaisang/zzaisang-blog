---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/url';

interface Props {
	project: CollectionEntry<'projects'>;
	// 카드가 놓이는 맥락의 제목 레벨 (홈 섹션 아래=3, /projects 인덱스=2). 기본 2.
	headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const { data, id } = project;
const TitleTag = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
	<TitleTag class="title"><a href={withBase(`/projects/${id}/`)}>{data.title}</a></TitleTag>
	<p class="summary">{data.summary}</p>
	{data.techStack.length > 0 && <p class="stack">{data.techStack.join(' · ')}</p>}
</article>

<style>
	.card {
		border-top: 2px solid rgb(var(--black));
		padding-top: 16px;
	}
	.title {
		margin: 0;
		font-size: 20px;
		font-weight: 600;
	}
	.summary {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}
	.stack {
		margin: 12px 0 0;
		font-size: 13px;
		color: rgb(var(--gray));
	}
</style>
