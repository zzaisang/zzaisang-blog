---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/url';
---

<header class="wrap">
	<a class="brand" href={withBase('/')}>{SITE_TITLE}</a>
	<nav aria-label="주 메뉴">
		<HeaderLink href="/blog">글</HeaderLink>
		<HeaderLink href="/categories">카테고리</HeaderLink>
		<HeaderLink href="/projects">프로젝트</HeaderLink>
		<HeaderLink href="/about">소개</HeaderLink>
	</nav>
</header>
<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 28px;
		padding-bottom: 28px;
	}
	.brand {
		font-weight: 600;
		font-size: 18px;
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		gap: 28px;
		font-size: 15px;
	}
	@media (max-width: 720px) {
		nav {
			gap: 16px;
		}
	}
</style>
